# =============================================================================
# Cronograph — Production Environment Variables
# Copy to .env.production and fill in the values
# NEVER commit the actual .env.production file
# =============================================================================

# --- Database ---
POSTGRES_USER=cronograph
POSTGRES_PASSWORD=<strong-random-password>
POSTGRES_DB=cronograph

# --- JWT / Auth ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=<generated-secret-key>
ACCESS_TTL_MIN=15
REFRESH_TTL_DAYS=14

# --- Cookies ---
COOKIE_SECURE=true
COOKIE_DOMAIN=cronograph.duckdns.org

# --- CORS ---
CORS_ORIGINS=["https://cronograph.duckdns.org"]

# --- Frontend build arg ---
NEXT_PUBLIC_API_URL=https://cronograph.duckdns.org
